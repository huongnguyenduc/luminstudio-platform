package(default_visibility = ["//visibility:public"])

load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@npm//apps/web-admin:vite/package_json.bzl", vite_bin = "bin")
load("@npm//apps/web-admin:vitest/package_json.bzl", vitest_bin = "bin")

npm_link_all_packages(name = "node_modules")

js_library(
    name = "vite-config",
    srcs = ["vite.config.ts"],
    deps = [
        ":node_modules/@vitejs/plugin-react",
        ":node_modules/vite",
        ":node_modules/vitest",
    ],
)

vite_bin.vite(
    name = "web-admin",
    srcs = [
        "index.html",
        "src/App.css",
        "src/App.test.tsx",
        "src/App.tsx",
        "src/index.css",
        "src/main.tsx",
        "src/vite-env.d.ts",
        "tsconfig.json",
        ":node_modules/@types/react",
        ":node_modules/@types/react-dom",
        ":node_modules/react",
        ":node_modules/react-dom",
        ":vite-config",
    ],
    chdir = package_name(),
    fixed_args = [
        "build",
        "--config",
        "vite.config.ts",
    ],
    out_dirs = ["dist"],
)

vitest_bin.vitest_test(
    name = "web-admin-test",
    args = [
        "run",
        "--config",
        "vite.config.ts",
    ],
    chdir = package_name(),
    data = [
        "src/App.css",
        "src/App.test.tsx",
        "src/App.tsx",
        "src/index.css",
        "src/main.tsx",
        "tsconfig.json",
        ":node_modules/@types/react",
        ":node_modules/@types/react-dom",
        ":node_modules/react",
        ":node_modules/react-dom",
        ":vite-config",
    ],
)

exports_files(["README.md"])
